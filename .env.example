# Postgres. Local dev: `pnpm db:up` then use the line below. Production: the Neon pooled URL.
DATABASE_URL=postgres://aloft:aloft@localhost:5432/aloft

# `openssl rand -base64 32`
AUTH_SECRET=

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI for local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to true when hosting anywhere other than Vercel.
# AUTH_TRUST_HOST=true

# Optional until Phase 6.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic-api

# Optional CDN prefix for /models/*.glb. Leave empty to serve from this app.
NEXT_PUBLIC_ASSET_BASE_URL=

# Phase 6: notes to flashcards.
# Model for card generation. Card quality is the product; Opus is the default.
ANTHROPIC_MODEL_CARDS=claude-opus-5
# Any 32+ character secret. Encrypts users' own Anthropic keys at rest.
ENCRYPTION_KEY=
# Monthly AI spend allowed per user on the platform key, in cents.
MONTHLY_LLM_QUOTA_CENTS=500

# Development and CI only. Both are refused in production.
# LLM_PROVIDER=fake makes sentence cards from the passage with no model, key, or network.
# MIN_SESSION_MS_OVERRIDE shortens the five-minute minimum so end-to-end runs do not wait.
# MIN_SESSION_MS_OVERRIDE=10000
# E2E_TEST_MODE=true lets the two above through the production gates. CI only.
